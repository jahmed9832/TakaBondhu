# ==========================================
# TakaBondhu - Root Environment Variables Example
# ==========================================
# Copy to backend/.env to configure backend services
# (Note: TakaBondhu runs completely in offline deterministic demo mode without API keys!)

PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_VOICE_MODEL=gemini-3.1-flash-live-preview

# Supabase PostgreSQL + pgvector RAG Configuration (Optional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder

# LiveKit Cloud Realtime Voice AI Configuration (Optional)
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
