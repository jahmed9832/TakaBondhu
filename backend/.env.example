# ==========================================
# TakaBachao - Backend Environment Variables
# ==========================================

# ==========================================
# Gemini AI Configuration (SERVER-ONLY - Never expose to frontend or git)
# Get your API key at: https://aistudio.google.com/app/apikey
# ==========================================
# For existing text analysis pipeline (Rule Engine + Gemini + RAG):
GEMINI_API_KEY=

# For LiveKit Google Realtime Voice AI plugin (@livekit/agents-plugin-google):
GOOGLE_API_KEY=

# Currently supported Gemini Live audio model:
GEMINI_VOICE_MODEL=gemini-3.1-flash-live-preview

# Server Port (default 5000)
PORT=5000

# ==========================================
# Supabase PostgreSQL + pgvector RAG Configuration
# ==========================================
# Found in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co

# Preferred current Supabase API Keys:
# Publishable key (safe for public/client access where appropriate):
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (SERVER-ONLY - Never expose to frontend or commit to git):
SUPABASE_SECRET_KEY=sb_secret_...

# ==========================================
# LiveKit Cloud Realtime Voice AI Configuration
# ==========================================
# Get these from LiveKit Cloud Dashboard -> Settings -> Keys:
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

