{
  "name": "scamshield-live",
  "version": "1.0.0",
  "private": true,
  "description": "TakaBachao - Protect. Save. Plan. Your AI companion for safer financial decisions.",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "ingest-knowledge": "cd backend && npm run ingest-knowledge",
    "voice-agent": "cd backend && npm run voice-agent",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
