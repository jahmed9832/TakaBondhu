              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "v1.0.0-char-wb-lr"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold",
            "default": 0.5
          },
          "models": {
            "additionalProperties": true,
            "type": "object",
            "title": "Models",
            "default": {}
          },
          "sklearn_version": {
            "type": "string",
            "title": "Sklearn Version",
            "default": ""
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "loaded"
        ],
        "title": "HealthResponse"
      },
      "PredictRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Text",
            "description": "Message text in Bengali, Banglish, or English"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "active"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "label_at_threshold": {
            "type": "integer",
            "title": "Label At Threshold"
          },
          "scam_type": {
            "type": "string",
            "title": "Scam Type"
          },
          "reason_codes": {
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "type": "array",
            "title": "Reason Codes"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          }
        },
        "type": "object",
        "required": [
          "probability",
          "label_at_threshold",
          "scam_type",
          "reason_codes",
          "model_version",
          "threshold"
        ],
        "title": "PredictResponse"
      },
      "ReasonCode": {
        "properties": {
          "ngram": {
            "type": "string",
            "title": "Ngram"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          }
        },
        "type": "object",
        "required": [
          "ngram",
          "contribution"
        ],
        "title": "ReasonCode"
      },
      "TransactionScreenRequest": {
        "properties": {
          "transaction": {
            "additionalProperties": true,
            "type": "object",
            "title": "Transaction",
            "description": "Transaction payload containing amount, sender, receiver, etc."
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message",
            "description": "Optional associated SMS or chat message"
          },
          "session_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Context"
          }
        },
        "type": "object",
        "required": [
          "transaction"
        ],
        "title": "TransactionScreenRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}